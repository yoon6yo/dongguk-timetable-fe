# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright (e2e/ and playwright.config.ts themselves ARE committed — only
# run output is ignored)
/test-results/
/playwright-report/
/blob-report/

# oh-my-design / oh-my-claudecode session state — DESIGN.md is a working
# scratch artifact for this project, not a committed doc (same treatment as
# dongguk-timetable-be's STATUS.md)
DESIGN.md
DESIGN_DEPRECATED.md
.omd/
.omc/
